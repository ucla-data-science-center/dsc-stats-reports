# Output
# We are currently committing docs/ for "easy" deployment,
# but if we use GitHub Actions to deploy to gh-pages branch, we could ignore it.
# For now, let's keep it available if the user wants to push manually.
# docs/

/.quarto/
**/*.quarto_ipynb

# ── Credentials ──────────────────────────────────────────────
.env

# ── Raw data containing PII ───────────────────────────────────
# Calendly / scheduling exports (patron names, emails, phone numbers)
data/raw/consultations/event-data-*.csv
# LibInsight exports imported from Google Drive (patron details)
data/raw/consultations/imported_gdrive/
# Trello backup snapshots (treat as raw data)
data/raw/consultations/*.backup-*.csv
# General raw intake inbox (assume PII until vetted)
data/inbox/

# ── Machine-specific analysis outputs ────────────────────────
# Filesystem inventory with local absolute paths — not portable
data/processed/repo_cleanup/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Row-level consultation and registration data: never public (contain personal
# contact details). Kept locally / in the dsc-stats-integration restricted area.
# consulting.qmd publishes only data/processed/consultations/public/*.csv.
data/raw/consultations/
data/processed/consultations/*.rds
data/processed/consultations/*.rda
archive/data_legacy_link/
archive/dsc-stats-eval/data/

# Dataverse deposit packages (built locally by scripts/dataverse/build_package.py)
release/
